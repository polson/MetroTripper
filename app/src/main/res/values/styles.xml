<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryDark">@color/dark_blue</item>
        <item name="colorAccent">@color/kelly_green</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="actionBarStyle">@style/Widget.Styled.ActionBar</item>
    </style>

    <style name="horizontal_line">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dip</item>
    </style>

    <style name="Widget.Styled.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="android:displayOptions">showHome|useLogo|showTitle|homeAsUp</item>
        <item name="displayOptions">showHome|useLogo|showTitle|homeAsUp</item>
        <item name="android:background">@color/blue</item>
        <item name="background">@color/blue</item>
    </style>

    <style name="hyperlink">
        <item name="android:textColor">@color/hyperlink_blue</item>
    </style>
</resources>
